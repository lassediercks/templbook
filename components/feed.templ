package components

templ ComposeTweet() {
	<div class="compose-box">
		<div class="compose-avatar" title="Your profile">YO</div>
		<div class="compose-right">
			<textarea
				class="compose-textarea"
				placeholder="What is happening?!"
				rows="3"
			></textarea>
			<div class="compose-footer">
				<div class="compose-tools">
					<!-- Image -->
					<button class="compose-tool-btn" title="Media">
						<svg viewBox="0 0 24 24">
							<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
							<circle cx="8.5" cy="8.5" r="1.5"></circle>
							<polyline points="21 15 16 10 5 21"></polyline>
						</svg>
					</button>
					<!-- GIF -->
					<button class="compose-tool-btn" title="GIF">
						<svg viewBox="0 0 24 24">
							<rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
							<line x1="7" y1="2" x2="7" y2="22"></line>
							<line x1="17" y1="2" x2="17" y2="22"></line>
							<line x1="2" y1="12" x2="22" y2="12"></line>
							<line x1="2" y1="7" x2="7" y2="7"></line>
							<line x1="2" y1="17" x2="7" y2="17"></line>
							<line x1="17" y1="17" x2="22" y2="17"></line>
							<line x1="17" y1="7" x2="22" y2="7"></line>
						</svg>
					</button>
					<!-- Poll -->
					<button class="compose-tool-btn" title="Poll">
						<svg viewBox="0 0 24 24">
							<line x1="18" y1="20" x2="18" y2="10"></line>
							<line x1="12" y1="20" x2="12" y2="4"></line>
							<line x1="6" y1="20" x2="6" y2="14"></line>
						</svg>
					</button>
					<!-- Emoji -->
					<button class="compose-tool-btn" title="Emoji">
						<svg viewBox="0 0 24 24">
							<circle cx="12" cy="12" r="10"></circle>
							<path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
							<line x1="9" y1="9" x2="9.01" y2="9"></line>
							<line x1="15" y1="9" x2="15.01" y2="9"></line>
						</svg>
					</button>
				</div>
				<button class="compose-submit">Post</button>
			</div>
		</div>
	</div>
}

templ Sidebar() {
	<aside class="sidebar">
		<div class="sidebar-logo" title="Home">
			<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.733-8.835L1.254 2.25H8.08l4.258 5.63 5.906-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
			</svg>
		</div>
		<nav>
			<ul class="sidebar-nav">
				<li>
					<a class="nav-item active" href="#">
						<svg class="nav-icon" viewBox="0 0 24 24">
							<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
							<polyline points="9 22 9 12 15 12 15 22"></polyline>
						</svg>
						<span class="nav-label">Home</span>
					</a>
				</li>
				<li>
					<a class="nav-item" href="#">
						<svg class="nav-icon" viewBox="0 0 24 24">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<span class="nav-label">Explore</span>
					</a>
				</li>
				<li>
					<a class="nav-item" href="#">
						<svg class="nav-icon" viewBox="0 0 24 24">
							<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
							<path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
						</svg>
						<span class="nav-label">Notifications</span>
					</a>
				</li>
				<li>
					<a class="nav-item" href="#">
						<svg class="nav-icon" viewBox="0 0 24 24">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
						<span class="nav-label">Messages</span>
					</a>
				</li>
				<li>
					<a class="nav-item" href="#">
						<svg class="nav-icon" viewBox="0 0 24 24">
							<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
						</svg>
						<span class="nav-label">Bookmarks</span>
					</a>
				</li>
				<li>
					<a class="nav-item" href="#">
						<svg class="nav-icon" viewBox="0 0 24 24">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
						<span class="nav-label">Profile</span>
					</a>
				</li>
			</ul>
		</nav>
		<button class="tweet-btn">Post</button>
	</aside>
}

templ RightPanel() {
	<div class="right-panel">
		<div class="search-box">
			<svg viewBox="0 0 24 24">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<input type="text" placeholder="Search"/>
		</div>
		<div class="trends-card">
			<div class="card-title">What&#39;s happening</div>
			<div class="trend-item">
				<div class="trend-category">Technology · Trending</div>
				<div class="trend-name">#GoLang</div>
				<div class="trend-count">42.3k posts</div>
			</div>
			<div class="trend-item">
				<div class="trend-category">Tech · Trending</div>
				<div class="trend-name">#WebAssembly</div>
				<div class="trend-count">18.1k posts</div>
			</div>
			<div class="trend-item">
				<div class="trend-category">Trending in Software</div>
				<div class="trend-name">#OpenSource</div>
				<div class="trend-count">91.7k posts</div>
			</div>
			<div class="trend-item">
				<div class="trend-category">Technology · Trending</div>
				<div class="trend-name">#Rust</div>
				<div class="trend-count">55.2k posts</div>
			</div>
		</div>
		<div class="who-to-follow-card">
			<div class="card-title">Who to follow</div>
			<div class="follow-item">
				<div class="avatar" style="background:#0ea5e9;width:40px;height:40px;font-size:14px;">RK</div>
				<div class="follow-info">
					<span class="follow-name">Rob Pike</span>
					<span class="follow-handle">{ "@rob_pike" }</span>
				</div>
				<button class="follow-btn">Follow</button>
			</div>
			<div class="follow-item">
				<div class="avatar" style="background:#8b5cf6;width:40px;height:40px;font-size:14px;">RA</div>
				<div class="follow-info">
					<span class="follow-name">Russ Cox</span>
					<span class="follow-handle">{ "@_rsc" }</span>
				</div>
				<button class="follow-btn">Follow</button>
			</div>
			<div class="follow-item">
				<div class="avatar" style="background:#f59e0b;width:40px;height:40px;font-size:14px;">AH</div>
				<div class="follow-info">
					<span class="follow-name">Adrian Hesketh</span>
					<span class="follow-handle">{ "@adrianhesketh" }</span>
				</div>
				<button class="follow-btn">Follow</button>
			</div>
		</div>
	</div>
}

templ Feed(tweets []Tweet) {
	@Layout("Twittempl / Home") {
		@Sidebar()
		<main class="main-content">
			<div class="column-header">
				<h1>Home</h1>
				<p>Your personalised timeline</p>
			</div>
			@ComposeTweet()
			for _, t := range tweets {
				@TweetCard(t)
			}
		</main>
		@RightPanel()
	}
}
