package components

templ Hero() {
<section class="hero">
	<style>
		.hero {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 96px 24px 80px;
			max-width: 760px;
			margin: 0 auto;
		}

		.hero-badge {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			background: #f0f4ff;
			color: #2563eb;
			font-size: 12px;
			font-weight: 600;
			padding: 4px 12px;
			border-radius: 9999px;
			margin-bottom: 28px;
			letter-spacing: 0.02em;
			text-transform: uppercase;
		}

		.hero-title {
			font-size: clamp(40px, 7vw, 68px);
			font-weight: 800;
			letter-spacing: -0.03em;
			line-height: 1.05;
			color: #111;
			margin-bottom: 20px;
		}

		.hero-title .accent {
			background: linear-gradient(135deg, #2563eb, #7c3aed);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
		}

		.hero-sub {
			font-size: 18px;
			color: #555;
			max-width: 520px;
			line-height: 1.65;
			margin-bottom: 40px;
		}

		.hero-actions {
			display: flex;
			gap: 12px;
			flex-wrap: wrap;
			justify-content: center;
		}

		.hero-code {
			margin-top: 56px;
			background: #f6f8fa;
			border: 1px solid #e4e4e4;
			border-radius: 10px;
			padding: 20px 28px;
			font-family: "SF Mono", "Fira Code", "Fira Mono", monospace;
			font-size: 13px;
			color: #333;
			text-align: left;
			width: 100%;
			max-width: 560px;
			line-height: 1.7;
		}
	</style>
	<div class="hero-badge">Go + templ</div>
	<h1 class="hero-title">
		<span class="accent">templ</span>Book
	</h1>
	<p class="hero-sub">
		Build, preview, and document your templ components in isolation.
		Define stories in pure Go and browse them live in a clean UI.
	</p>
	@ButtonStyles()
	<div class="hero-actions">
		@ButtonPrimary("Get Started", "#getting-started")
		@ButtonOutline("View on GitHub", "https://github.com")
	</div>
	<div class="hero-code">
		@templ.Raw(heroCodeSnippet)
	</div>
</section>
}

const heroCodeSnippet = `<span style="color:#999">// one import, one function call</span>
book := templbook.<span style="color:#7c3aed">New</span>(<span style="color:#059669">"My App"</span>).
<span style="color:#7c3aed">Add</span>(<span style="color:#059669">"Button"</span>,
templbook.Story{Name: <span style="color:#059669">"Primary"</span>, Component: ui.<span
	style="color:#7c3aed">Button</span>(<span style="color:#059669">"primary"</span>)},
templbook.Story{Name: <span style="color:#059669">"Ghost"</span>, Component: ui.<span
	style="color:#7c3aed">Button</span>(<span style="color:#059669">"ghost"</span>)},
).
<span style="color:#7c3aed">ListenAndServe</span>(<span style="color:#059669">":6006"</span>)`