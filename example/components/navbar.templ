package components

templ Navbar() {
	<nav class="navbar">
		<style>
			.navbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 24px;
				height: 56px;
				border-bottom: 1px solid #f0f0f0;
				background: #fff;
			}
			.navbar-brand {
				font-size: 15px;
				font-weight: 800;
				color: #111;
				letter-spacing: -0.02em;
			}
			.navbar-brand .accent {
				background: linear-gradient(135deg, #2563eb, #7c3aed);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.navbar-links {
				display: flex;
				align-items: center;
				gap: 24px;
			}
			.navbar-link {
				font-size: 14px;
				color: #555;
				text-decoration: none;
				font-weight: 500;
			}
			.navbar-link:hover { color: #111; }
		</style>
		<div class="navbar-brand"><span class="accent">templ</span>Book</div>
		<div class="navbar-links">
			<a class="navbar-link" href="#getting-started">Docs</a>
			<a class="navbar-link" href="https://github.com">GitHub</a>
		</div>
	</nav>
}
