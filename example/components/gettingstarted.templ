package components

templ GettingStarted() {
	<section class="gs" id="getting-started">
		<style>
			.gs {
				padding: 64px 24px 80px;
				max-width: 760px;
				margin: 0 auto;
			}
			.gs-heading {
				font-size: 28px;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: #111;
				margin-bottom: 8px;
			}
			.gs-sub {
				font-size: 15px;
				color: #666;
				margin-bottom: 40px;
			}
			.gs-steps {
				display: flex;
				flex-direction: column;
				gap: 32px;
			}
			.gs-step {
				display: flex;
				gap: 20px;
			}
			.gs-step-num {
				width: 28px;
				height: 28px;
				border-radius: 50%;
				background: #111;
				color: #fff;
				font-size: 13px;
				font-weight: 700;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				margin-top: 2px;
			}
			.gs-step-title {
				font-size: 15px;
				font-weight: 700;
				color: #111;
				margin-bottom: 8px;
			}
		</style>
		<h2 class="gs-heading">Getting started</h2>
		<p class="gs-sub">Up and running in under a minute.</p>
		<div class="gs-steps">
			<div class="gs-step">
				<div class="gs-step-num">1</div>
				<div>
					<div class="gs-step-title">Install</div>
					@CodeBlock() {
						go get github.com/lassediercks/templbook
					}
				</div>
			</div>
			<div class="gs-step">
				<div class="gs-step-num">2</div>
				<div>
					<div class="gs-step-title">Define your stories</div>
					@CodeBlock() {
						@templ.Raw(gsCodeSnippet)
					}
				</div>
			</div>
			<div class="gs-step">
				<div class="gs-step-num">3</div>
				<div>
					<div class="gs-step-title">Run it</div>
					@CodeBlock() {
						@templ.Raw(`go run . <span style="color:#999">// → http://localhost:6006</span>`)
					}
				</div>
			</div>
		</div>
	</section>
}

const gsCodeSnippet = `<span style="color:#2563eb">package</span> main

<span style="color:#2563eb">import</span> (
    <span style="color:#059669">"github.com/lassediercks/templbook"</span>
    <span style="color:#059669">"myapp/components"</span>
)

<span style="color:#2563eb">func</span> <span style="color:#7c3aed">main</span>() {
    templbook.<span style="color:#7c3aed">New</span>(<span style="color:#059669">"My App"</span>).
        <span style="color:#7c3aed">Add</span>(<span style="color:#059669">"Button"</span>,
            templbook.Story{Name: <span style="color:#059669">"Primary"</span>, Component: components.<span style="color:#7c3aed">Button</span>(<span style="color:#059669">"primary"</span>)},
            templbook.Story{Name: <span style="color:#059669">"Ghost"</span>,   Component: components.<span style="color:#7c3aed">Button</span>(<span style="color:#059669">"ghost"</span>)},
        ).
        <span style="color:#7c3aed">ListenAndServe</span>(<span style="color:#059669">":6006"</span>)
}`
