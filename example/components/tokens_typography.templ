package components

templ TokensTypography() {
	<div class="tokens-type">
		<style>
			.tokens-type {
				padding: 32px;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				color: #111;
			}
			.tokens-type .tokens-section {
				margin-bottom: 48px;
			}
			.tokens-type .tokens-section-title {
				font-size: 11px;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #999;
				margin-bottom: 20px;
				padding-bottom: 8px;
				border-bottom: 1px solid #f0f0f0;
			}
			.type-row {
				display: flex;
				align-items: baseline;
				gap: 24px;
				padding: 16px 0;
				border-bottom: 1px solid #f4f4f4;
			}
			.type-row:last-child { border-bottom: none; }
			.type-meta {
				width: 200px;
				flex-shrink: 0;
			}
			.type-meta-name {
				font-size: 12px;
				font-weight: 600;
				color: #111;
				margin-bottom: 2px;
			}
			.type-meta-value {
				font-size: 11px;
				color: #999;
				font-family: "SF Mono", "Fira Code", monospace;
				line-height: 1.6;
			}
			.type-sample {
				flex: 1;
				color: #111;
			}
			.family-block {
				padding: 16px 0;
				border-bottom: 1px solid #f4f4f4;
			}
			.family-block:last-child { border-bottom: none; }
			.family-name {
				font-size: 11px;
				font-weight: 600;
				color: #999;
				font-family: "SF Mono", "Fira Code", monospace;
				margin-bottom: 8px;
			}
			.family-sample {
				font-size: 18px;
				color: #111;
				line-height: 1.5;
			}
		</style>
		<div class="tokens-section">
			<div class="tokens-section-title">Font Families</div>
			<div class="family-block">
				<div class="family-name">sans — body &amp; UI</div>
				<div class="family-sample" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif">
					The quick brown fox jumps over the lazy dog
				</div>
			</div>
			<div class="family-block">
				<div class="family-name">mono — code</div>
				<div class="family-sample" style="font-family:'SF Mono','Fira Code',monospace">
					go get github.com/lassediercks/templbook
				</div>
			</div>
		</div>
		<div class="tokens-section">
			<div class="tokens-section-title">Type Scale</div>
			<div class="type-row">
				<div class="type-meta">
					<div class="type-meta-name">Display</div>
					<div class="type-meta-value">clamp(40px, 7vw, 68px)<br/>weight 800 · -0.03em</div>
				</div>
				<div class="type-sample" style="font-size:clamp(40px,7vw,68px);font-weight:800;letter-spacing:-0.03em;line-height:1.05">Heading</div>
			</div>
			<div class="type-row">
				<div class="type-meta">
					<div class="type-meta-name">Heading 1</div>
					<div class="type-meta-value">28px · weight 800 · -0.02em</div>
				</div>
				<div class="type-sample" style="font-size:28px;font-weight:800;letter-spacing:-0.02em">Getting started</div>
			</div>
			<div class="type-row">
				<div class="type-meta">
					<div class="type-meta-name">Heading 2</div>
					<div class="type-meta-value">22px · weight 700</div>
				</div>
				<div class="type-sample" style="font-size:22px;font-weight:700">Component preview</div>
			</div>
			<div class="type-row">
				<div class="type-meta">
					<div class="type-meta-name">Body Large</div>
					<div class="type-meta-value">18px · weight 400 · 1.65</div>
				</div>
				<div class="type-sample" style="font-size:18px;line-height:1.65">The quick brown fox jumps over the lazy dog</div>
			</div>
			<div class="type-row">
				<div class="type-meta">
					<div class="type-meta-name">Body</div>
					<div class="type-meta-value">15px · weight 400 · 1.6</div>
				</div>
				<div class="type-sample" style="font-size:15px;line-height:1.6">The quick brown fox jumps over the lazy dog</div>
			</div>
			<div class="type-row">
				<div class="type-meta">
					<div class="type-meta-name">Small</div>
					<div class="type-meta-value">13px · weight 400 · 1.6</div>
				</div>
				<div class="type-sample" style="font-size:13px;line-height:1.6">The quick brown fox jumps over the lazy dog</div>
			</div>
			<div class="type-row">
				<div class="type-meta">
					<div class="type-meta-name">Label</div>
					<div class="type-meta-value">11px · weight 700 · 0.08em</div>
				</div>
				<div class="type-sample" style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase">Design tokens</div>
			</div>
		</div>
		<div class="tokens-section">
			<div class="tokens-section-title">Weights</div>
			<div class="type-row">
				<div class="type-meta"><div class="type-meta-name">Regular</div><div class="type-meta-value">400</div></div>
				<div class="type-sample" style="font-size:18px;font-weight:400">The quick brown fox</div>
			</div>
			<div class="type-row">
				<div class="type-meta"><div class="type-meta-name">Medium</div><div class="type-meta-value">500</div></div>
				<div class="type-sample" style="font-size:18px;font-weight:500">The quick brown fox</div>
			</div>
			<div class="type-row">
				<div class="type-meta"><div class="type-meta-name">Semibold</div><div class="type-meta-value">600</div></div>
				<div class="type-sample" style="font-size:18px;font-weight:600">The quick brown fox</div>
			</div>
			<div class="type-row">
				<div class="type-meta"><div class="type-meta-name">Bold</div><div class="type-meta-value">700</div></div>
				<div class="type-sample" style="font-size:18px;font-weight:700">The quick brown fox</div>
			</div>
			<div class="type-row">
				<div class="type-meta"><div class="type-meta-name">Extrabold</div><div class="type-meta-value">800</div></div>
				<div class="type-sample" style="font-size:18px;font-weight:800">The quick brown fox</div>
			</div>
		</div>
	</div>
}
