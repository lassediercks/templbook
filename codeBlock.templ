package templbook

var codeBlockStyleHandle = templ.NewOnceHandle()

templ codeBlock(code string) {
	if code != "" {
		@codeBlockStyleHandle.Once() {
			<style>
				.tb-code {
					border-top: 1px solid #e4e4e4;
					background: #f8f8f8;
				}
				.tb-code pre {
					padding: 16px 20px;
					font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
					font-size: 13px;
					line-height: 1.6;
					color: #374151;
					overflow-x: auto;
					white-space: pre;
				}
			</style>
		}
		<div class="tb-code">
			<pre>{ code }</pre>
		</div>
	}
}
